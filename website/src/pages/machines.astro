---
import Base from '../layouts/Base.astro';
import { loadMachines } from '../lib/machines';

const { machines, groups, formats } = loadMachines();

const lede =
  "The app's printer library, generated from the packs at build time: " +
  `${machines.length} machines from ${groups.length} manufacturers, writing ${formats.length} output formats.`;
---

<Base
  title="Machines"
  description="Every machine DragonFruit ships a printer profile for, with its build volume, panel resolution and output format, generated from the printer packs in the app."
  cardSummary="Every machine the app ships a profile for, read from its printer packs."
>
  <section class="shell page">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Machines</span>
    </nav>

    <header class="head">
      <h1>Machines</h1>
      <p class="lede">{lede}</p>
    </header>

    <div class="library" id="machines-list" data-library>
      {/* The rail is always in the markup, so the page does not reflow when the
          script arrives. Its buttons are anchors: without JavaScript they jump to
          the manufacturer's section, and the script turns them into a filter. The
          search field is the one control that cannot work without it, so it waits. */}
      <aside class="rail">
        <div class="rail__search" data-machine-search hidden>
          <input
            class="rail__input"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search printers"
            aria-label="Search machines by name, family, manufacturer or format"
            data-machine-query
          />
        </div>

        <div class="rail__makers" role="group" aria-label="Manufacturers">
          <a class="maker" href="#machines-list" data-maker data-manufacturer="" aria-current="true">
            <span class="maker__name">All machines</span>
            <span class="maker__count mono">{machines.length}</span>
          </a>
          {groups.map((group) => (
            <a class="maker" href={`#${group.slug}`} data-maker data-manufacturer={group.manufacturer}>
              <span class="maker__name">{group.manufacturer}</span>
              <span class="maker__count mono">{group.machines.length}</span>
            </a>
          ))}
        </div>
      </aside>

      <div class="library__main">
        {
          groups.map((group) => (
            <section class="group" id={group.slug} data-group data-manufacturer={group.manufacturer}>
              <h2 class="group__title">{group.manufacturer}</h2>

              {group.families.map((family) => (
                <div class="family" data-family>
                  <p class="family__label">
                    <span>{family.name}</span>
                  </p>

                  <div class="gallery">
                    {family.machines.map((machine) => (
                      <article
                        class="card"
                        data-machine-row
                        data-search={`${machine.name} ${machine.family} ${machine.manufacturer} ${machine.format}`.toLowerCase()}
                      >
                        <div class="card__figure">
                          {machine.image ? (
                            <img
                              class="card__image"
                              src={`/printers/${machine.slug}.webp`}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="card__missing mono muted">No render</span>
                          )}
                        </div>
                        <div class="card__body">
                          <p class="card__name">{machine.name}</p>
                          <p class="card__format mono muted">{machine.format}</p>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))
        }

        <p class="empty muted" data-machine-empty hidden>No machine matches that search.</p>
      </div>
    </div>

    <p class="footnote muted">
      Formats: <span class="mono">{formats.join(' · ')}</span>. A machine that is not listed has no profile in a pack
      yet; the Generic Machine profile is the reference target for anything else.
    </p>
  </section>
</Base>

<script>
  import { initMachineLibrary } from '../lib/machine-library';

  initMachineLibrary();
</script>

<style>
  .page {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-inline-size: 52rem;
    margin-bottom: 1.5rem;
  }

  .head h1 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
  }

  .head .lede {
    font-size: 0.9375rem;
  }

  /* Two columns from the first paint: the rail is in the markup, so nothing
     moves when the script arrives. */
  .library {
    display: grid;
    gap: 2rem;
    align-items: start;
    grid-template-columns: 14rem minmax(0, 1fr);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 5rem;
  }

  .rail__search[hidden] {
    display: none;
  }

  .rail__input {
    inline-size: 100%;
    padding: 0.55rem 0.8rem;
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--glass-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.15s var(--ease);
  }

  .rail__input::placeholder {
    color: var(--muted);
  }

  .rail__input:focus-visible {
    border-color: var(--accent);
  }

  .rail__makers {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .maker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    text-align: start;
    text-decoration: none;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .maker:hover {
    color: var(--ink);
    background: var(--glass-bg);
    border-color: var(--glass-border);
  }

  .maker[aria-current='true'] {
    color: var(--ink);
    background: var(--glass-bg);
    border-color: var(--border-strong);
  }

  .maker__count {
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  .library__main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-inline-size: 0;
  }

  .group[hidden],
  .family[hidden],
  .card[hidden] {
    display: none;
  }

  .group__title {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .family + .family {
    margin-top: 1.5rem;
  }

  /* The app's library separates families with a rule through the label. */
  .family__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .family__label::before,
  .family__label::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background: var(--border);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.75rem, 1fr));
    gap: 0.6rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    overflow: hidden;
    transition: border-color 0.15s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card__figure {
    display: grid;
    /* A definite row, so the render's 100% height has something to resolve
       against: an auto row makes it fall back to the image's own aspect. */
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    block-size: 6.5rem;
    padding: 0.5rem;
    background: var(--bg-inset);
  }

  /* A sized box plus `contain`: the render scales to fit and can never spill
     into the card's text, whatever aspect ratio the pack shipped. */
  .card__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .card__missing {
    font-size: 0.75rem;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.45rem 0.6rem 0.55rem;
  }

  .card__name {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card__format {
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .empty {
    font-size: 0.9375rem;
  }

  @media (max-width: 52rem) {
    .library {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail {
      position: static;
    }

    .rail__makers {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .footnote {
    margin-top: 3rem;
    max-inline-size: var(--measure);
    font-size: 0.875rem;
  }
</style>
