---
import Base from '../layouts/Base.astro';
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

/**
 * Every machine the app ships a profile for, read from the printer packs that
 * plugins carry (`plugins/<id>/printers/*.json`), plus the core Generic Machine.
 *
 * The page is generated rather than written by hand: a pack that gains a machine
 * changes this page on the next build, and a machine that is not in a pack cannot
 * be listed here by mistake. The layout follows the app's own Printer Library: a
 * manufacturer rail and search on the left, the presets grouped by family on the
 * right.
 */

interface Preset {
  presetId?: string;
  name?: string;
  manufacturer?: string;
  family?: string;
  imageAssetPath?: string;
  pixelSize?: { x?: number; y?: number };
  buildVolumeMm?: { width?: number | null; depth?: number | null; height?: number | null };
  display?: { resolutionX?: number; resolutionY?: number; outputFormat?: string };
}

interface Machine {
  slug: string;
  name: string;
  family: string;
  manufacturer: string;
  volume: string;
  resolution: string;
  format: string;
  /** Whether the pack ships a render, which `printer-images.mjs` turns into a thumbnail. */
  image: boolean;
}

interface Family {
  name: string;
  machines: Machine[];
}

interface Group {
  manufacturer: string;
  machines: Machine[];
  families: Family[];
}

/** The build runs from `website/`, and the packs live beside it. */
function repoRoot(): URL {
  let dir = process.cwd();
  for (let depth = 0; depth < 5; depth += 1) {
    if (existsSync(join(dir, 'plugins')) && existsSync(join(dir, 'website'))) {
      return new URL(`file://${dir.replace(/\\/g, '/')}/`);
    }
    dir = dirname(dir);
  }
  throw new Error(`machines: could not find the repository root from ${process.cwd()}`);
}

const root = repoRoot();

function readPresets(path: URL): Preset[] {
  return JSON.parse(readFileSync(fileURLToPath(path), 'utf8')) as Preset[];
}

function number(value: number | null | undefined): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

/** Rounded to a tenth of a millimetre, which is all a build volume needs. */
function millimetres(value: number): string {
  return String(Math.round(value * 10) / 10);
}

function toMachine(preset: Preset, printersDir: string): Machine {
  const resolutionX = number(preset.display?.resolutionX);
  const resolutionY = number(preset.display?.resolutionY);
  const pitchX = number(preset.pixelSize?.x);
  const pitchY = number(preset.pixelSize?.y);

  /* The app derives a missing build area from the panel: pixels times pixel pitch,
     in micrometres. Athena's 16K profile ships that way. */
  const width = number(preset.buildVolumeMm?.width) ?? (resolutionX && pitchX ? (resolutionX * pitchX) / 1000 : null);
  const depth = number(preset.buildVolumeMm?.depth) ?? (resolutionY && pitchY ? (resolutionY * pitchY) / 1000 : null);
  const height = number(preset.buildVolumeMm?.height);

  const render = preset.imageAssetPath ? join(printersDir, preset.imageAssetPath) : null;

  return {
    slug: preset.presetId ?? 'machine',
    name: preset.name?.trim() || 'Unnamed machine',
    family: preset.family?.trim() || 'Other',
    manufacturer: preset.manufacturer?.trim() || 'Other',
    volume:
      width !== null && depth !== null && height !== null
        ? `${millimetres(width)} × ${millimetres(depth)} × ${millimetres(height)} mm`
        : 'Not declared',
    resolution: resolutionX !== null && resolutionY !== null ? `${resolutionX} × ${resolutionY}` : 'Not declared',
    format: preset.display?.outputFormat?.trim() || 'Not declared',
    image: render !== null && existsSync(render),
  };
}

const machines: Machine[] = [];

const pluginsDir = fileURLToPath(new URL('plugins', root));
for (const plugin of readdirSync(pluginsDir, { withFileTypes: true })) {
  if (!plugin.isDirectory()) continue;

  const printersDir = join(pluginsDir, plugin.name, 'printers');
  let files: string[];
  try {
    files = readdirSync(printersDir).filter((file) => file.endsWith('.json'));
  } catch {
    /* A plugin that ships a format or a protocol instead of a printer pack. */
    continue;
  }

  for (const file of files) {
    for (const preset of readPresets(new URL(`plugins/${plugin.name}/printers/${file}`, root))) {
      machines.push(toMachine(preset, printersDir));
    }
  }
}

for (const preset of readPresets(new URL('profiles/printers/generic/printers.json', root))) {
  machines.push(toMachine(preset, fileURLToPath(new URL('profiles/printers/generic', root))));
}

const byManufacturer = new Map<string, Map<string, Machine[]>>();
for (const machine of machines) {
  const families = byManufacturer.get(machine.manufacturer) ?? new Map<string, Machine[]>();
  const family = families.get(machine.family) ?? [];
  family.push(machine);
  families.set(machine.family, family);
  byManufacturer.set(machine.manufacturer, families);
}

const groups: Group[] = [...byManufacturer.entries()]
  .map(([manufacturer, families]) => {
    const list: Family[] = [...families.entries()]
      .map(([name, entries]) => ({ name, machines: entries.sort((a, b) => a.name.localeCompare(b.name)) }))
      .sort((a, b) => a.name.localeCompare(b.name));

    return { manufacturer, machines: list.flatMap((family) => family.machines), families: list };
  })
  .sort((a, b) => b.machines.length - a.machines.length || a.manufacturer.localeCompare(b.manufacturer));

const formats = [...new Set(machines.map((machine) => machine.format))].sort();

const lede =
  "The app's printer library, generated from the packs at build time: " +
  `${machines.length} machines from ${groups.length} manufacturers, writing ${formats.length} output formats.`;

---

<Base
  title="Machines"
  description="Every machine DragonFruit ships a printer profile for, with its build volume, panel resolution and output format, generated from the printer packs in the app."
  cardSummary="Every machine the app ships a profile for, read from its printer packs."
>
  <section class="shell page">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Machines</span>
    </nav>

    <header class="head">
      <h1>Machines</h1>
      <p class="lede">{lede}</p>
    </header>

    <div class="library" data-library>
      {/* Hidden until the script that drives the filter is running: the rail is a
          control, and a control that does nothing is worse than none. */}
      <aside class="rail" data-machine-rail hidden>
        <div class="rail__search">
          <input
            class="rail__input"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search printers"
            aria-label="Search machines by name, family, manufacturer or format"
            data-machine-query
          />
        </div>

        <div class="rail__makers" role="group" aria-label="Manufacturers">
          <button class="maker" type="button" data-maker data-manufacturer="" aria-pressed="true">
            <span class="maker__name">All machines</span>
            <span class="maker__count mono">{machines.length}</span>
          </button>
          {groups.map((group) => (
            <button class="maker" type="button" data-maker data-manufacturer={group.manufacturer} aria-pressed="false">
              <span class="maker__name">{group.manufacturer}</span>
              <span class="maker__count mono">{group.machines.length}</span>
            </button>
          ))}
        </div>
      </aside>

      <div class="library__main">
        {
          groups.map((group) => (
            <section class="group" data-group data-manufacturer={group.manufacturer}>
              <h2 class="group__title">{group.manufacturer}</h2>

              {group.families.map((family) => (
                <div class="family" data-family>
                  <p class="family__label">
                    <span>{family.name}</span>
                  </p>

                  <div class="gallery">
                    {family.machines.map((machine) => (
                      <article
                        class="card"
                        data-machine-row
                        data-search={`${machine.name} ${machine.family} ${machine.manufacturer} ${machine.format}`.toLowerCase()}
                      >
                        <div class="card__figure">
                          {machine.image ? (
                            <img
                              class="card__image"
                              src={`/printers/${machine.slug}.webp`}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="card__missing mono muted">No render</span>
                          )}
                        </div>
                        <div class="card__body">
                          <p class="card__name">{machine.name}</p>
                          <p class="card__spec mono muted">{machine.volume}</p>
                          <p class="card__spec mono muted">
                            {machine.resolution} · {machine.format}
                          </p>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))
        }

        <p class="empty muted" data-machine-empty hidden>No machine matches that search.</p>
      </div>
    </div>

    <p class="footnote muted">
      Formats: <span class="mono">{formats.join(' · ')}</span>. A machine that is not listed has no profile in a pack
      yet; the Generic Machine profile is the reference target for anything else.
    </p>
  </section>
</Base>

<script>
  import { initMachineLibrary } from '../lib/machine-library';

  initMachineLibrary();
</script>

<style>
  .page {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-inline-size: 52rem;
    margin-bottom: 1.5rem;
  }

  .head h1 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
  }

  .head .lede {
    font-size: 0.9375rem;
  }

  .library {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  /* The rail only exists once the script can drive it; without it the machines
     read as one column of groups. */
  .library[data-ready] {
    grid-template-columns: 14rem minmax(0, 1fr);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 5rem;
  }

  .rail[hidden] {
    display: none;
  }

  .rail__input {
    inline-size: 100%;
    padding: 0.55rem 0.8rem;
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--glass-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.15s var(--ease);
  }

  .rail__input::placeholder {
    color: var(--muted);
  }

  .rail__input:focus-visible {
    border-color: var(--accent);
  }

  .rail__makers {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .maker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    text-align: start;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .maker:hover {
    color: var(--ink);
    background: var(--glass-bg);
    border-color: var(--glass-border);
  }

  .maker[aria-pressed='true'] {
    color: var(--ink);
    background: var(--glass-bg);
    border-color: var(--border-strong);
  }

  .maker__count {
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  .library__main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-inline-size: 0;
  }

  .group[hidden],
  .family[hidden],
  .card[hidden] {
    display: none;
  }

  .group__title {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .family + .family {
    margin-top: 1.5rem;
  }

  /* The app's library separates families with a rule through the label. */
  .family__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .family__label::before,
  .family__label::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background: var(--border);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    overflow: hidden;
    transition: border-color 0.15s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card__figure {
    display: grid;
    place-items: center;
    block-size: 8.25rem;
    padding: 0.6rem;
    background: var(--bg-inset);
  }

  .card__image {
    max-inline-size: 100%;
    max-block-size: 100%;
    object-fit: contain;
  }

  .card__missing {
    font-size: 0.75rem;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem 0.7rem;
  }

  .card__name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card__spec {
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .empty {
    font-size: 0.9375rem;
  }

  @media (max-width: 52rem) {
    .library[data-ready] {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail {
      position: static;
    }

    .rail__makers {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .footnote {
    margin-top: 3rem;
    max-inline-size: var(--measure);
    font-size: 0.875rem;
  }
</style>
