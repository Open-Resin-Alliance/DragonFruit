---
import Base from '../layouts/Base.astro';
import { LINKS } from '../data/site';
import {
  DEV_FEED_URL,
  RELEASES_API_URL,
  devFeedTargets,
  fetchJson,
  formatDate,
  recentPreviews,
  releaseUrlFor,
  toPreviewBuild,
  type PreviewBuild,
  type Release,
  type UpdaterFeed,
} from '../lib/releases';

/**
 * Both kinds of build the site does not download from its front page, each read
 * at build time from the source that actually knows:
 *
 * - the **developer build** from `latest-dev.json`, the updater's own dev feed,
 *   because that is what an install on the dev channel updates to - asking GitHub
 *   for the newest prerelease answers a different question and gets it wrong;
 * - the **branch previews** from the releases API, because nothing else lists
 *   them. That list is a build-time snapshot, then refreshed in the browser:
 *   preview releases are deleted and recreated on every push, so a snapshot can
 *   name a release that no longer exists by the time the page is read. The built
 *   list is the no-JavaScript and failed-fetch fallback.
 *
 * Each section degrades on its own: an unreachable source says so and points at
 * GitHub rather than rendering an empty list as if there were no builds.
 */

interface DeveloperBuild {
  version: string;
  date: string;
  releaseUrl: string;
  targets: { label: string; url: string; file: string }[];
}

let developer: DeveloperBuild | null = null;
let reachedDevFeed = true;
let previews: PreviewBuild[] = [];
let reachedReleases = true;

try {
  const feed = await fetchJson<UpdaterFeed>(DEV_FEED_URL);
  if (feed.version) {
    developer = {
      version: `v${feed.version}`,
      date: formatDate(feed.pub_date),
      releaseUrl: releaseUrlFor(feed.version),
      targets: devFeedTargets(feed),
    };
  }
} catch {
  reachedDevFeed = false;
}

try {
  previews = recentPreviews(await fetchJson<Release[]>(RELEASES_API_URL, process.env.GITHUB_TOKEN)).map(toPreviewBuild);
} catch {
  reachedReleases = false;
}
---

<Base
  title="Preview Builds"
  description="The developer build and the branch previews of DragonFruit: what to install when the stable release is not what you want."
  cardSummary="The developer build from the updater's dev feed, and every branch that built an installer in the last two weeks."
>
  <section class="shell page">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Preview Builds</span>
    </nav>

    <header class="head">
      <p class="eyebrow">Beyond the release</p>
      <h1>Preview Builds</h1>
      <p class="lede">
        Two things live here: the developer build, which is what the dev channel of the updater follows, and the branch
        previews, which are cuts of work in progress that nothing updates.
      </p>
    </header>

    {
      !reachedDevFeed && (
        <p class="notice">
          The updater's dev feed did not answer while this page was built, so the developer build is missing from it.
          The feed itself is{' '}
          <a href="/latest-dev.json">/latest-dev.json</a>, and every build is on the{' '}
          <a href={LINKS.releases} rel="noopener noreferrer" target="_blank">
            releases page
          </a>
          .
        </p>
      )
    }

    {
      reachedDevFeed && (
        <section class="block" aria-labelledby="developer-title">
          <div class="block__head">
            <h2 class="block__title" id="developer-title">Developer build</h2>
            <p class="block__note">
              Read from the updater's own <code>latest-dev.json</code>, so this is exactly what an install on the dev
              channel updates to. Installing one of these puts you on that channel, and the updater keeps you there
              until you install a stable release again.
            </p>
          </div>

          {developer ? (
            <article class="build">
              <a class="build__tag mono" href={developer.releaseUrl} rel="noopener noreferrer" target="_blank">
                {developer.version}
              </a>
              <div class="build__right">
                <span class="build__date">{developer.date}</span>
                <div class="build__assets">
                  {developer.targets.map((target) => (
                    <a class="build__asset" href={target.url} title={target.file}>
                      {target.label}
                    </a>
                  ))}
                  <a class="build__more" href={developer.releaseUrl} rel="noopener noreferrer" target="_blank">
                    All files
                  </a>
                </div>
              </div>
            </article>
          ) : (
            <p class="muted">The dev feed carries no version right now.</p>
          )}
        </section>
      )
    }

    {
      reachedReleases && (
        <section class="block" aria-labelledby="previews-title">
          <div class="block__head">
            <h2 class="block__title" id="previews-title">Branch previews</h2>
            <p class="block__note">
              Every branch that builds an installer publishes one here for a fortnight. They are not wired into the
              updater: they will not replace an installed release, and an install of one should be replaced by a release
              when you are done with it.
            </p>
          </div>

          <div data-preview-body aria-live="polite">
            {previews.length > 0 ? (
              <ul class="builds">
                {previews.map((build) => (
                  <li class="build">
                    <a class="build__tag mono" href={build.url} rel="noopener noreferrer" target="_blank">
                      {build.tag}
                    </a>
                    <div class="build__right">
                      <span class="build__date">{build.date}</span>
                      <div class="build__assets">
                        {build.assets.length > 0 ? (
                          build.assets.map((asset) => (
                            <a class="build__asset" href={asset.url}>
                              {asset.label}
                            </a>
                          ))
                        ) : (
                          <span class="muted">No installer attached</span>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">No branch has built a preview in the last two weeks.</p>
            )}
          </div>
        </section>
      )
    }

    <p class="footnote muted">
      Installed releases read <code>latest.json</code> and <code>latest-dev.json</code> for updates; those files are
      published from release assets. Everything ever built is on the{' '}
      <a href={LINKS.releases} rel="noopener noreferrer" target="_blank">
        releases page
      </a>
      .
    </p>
  </section>
</Base>

<script>
  import { initPreviewFeed } from '../lib/preview-feed';

  initPreviewFeed();
</script>

<style>
  .page {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-inline-size: 52rem;
    margin-bottom: 2.5rem;
  }

  .head h1 {
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
  }

  .notice {
    display: block;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.5rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
  }

  .notice a,
  .footnote a {
    color: var(--accent);
  }

  .block + .block {
    margin-top: 3rem;
  }

  .block__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-inline-size: 52rem;
    margin-bottom: 1.25rem;
  }

  .block__title {
    font-size: 1.25rem;
  }

  .block__note {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .builds {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .build {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    padding: 1rem 1.15rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
  }

  /* The date sits with the downloads, not with the tag: reading a row is "which
     build, when, and what can I get for my platform". */
  .build__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .build__tag {
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .build__tag:hover {
    color: var(--accent);
  }

  .build__date {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .build__assets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .build__asset {
    padding: 0.25rem 0.65rem;
    font-size: 0.8125rem;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .build__more {
    padding: 0.25rem 0.65rem;
    font-size: 0.8125rem;
    color: var(--muted);
    border: 1px solid transparent;
    border-radius: 999px;
  }

  .build__more:hover {
    color: var(--ink);
    border-color: var(--border);
  }

  .build__asset:hover {
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  .footnote {
    margin-top: 3rem;
    max-inline-size: var(--measure);
    font-size: 0.875rem;
  }
</style>
