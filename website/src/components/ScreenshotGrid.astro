---
/**
 * The screenshots, as a 2x2 grid below the hero.
 *
 * Four images, one per view, all of them on screen at once rather than paged
 * through: nothing moves on its own, and every image is reachable by keyboard
 * because the whole tile is a button. The grid is pictures only - each tile
 * carries its caption as data, and the click that opens the image full size in
 * a native dialog brings the caption with it, plus arrows that step to the
 * next picture without closing it. That lightbox is the only script: without
 * JavaScript the grid is still a grid.
 */

interface Shot {
  src: string;
  alt: string;
  caption: string;
}

const shots: Shot[] = [
  {
    src: '/media/ui.webp',
    alt: 'DragonFruit in Prepare mode: a supported model on a dark grid, the model list on the left, and the plate\'s print estimate in the corner.',
    caption:
      'The workspace. Four modes along the top, the model list on the left, the plate in front of you and its own estimate in the corner.',
  },
  {
    src: '/media/support-studio.webp',
    alt: "Support mode with Support Studio open: the model's unsupported regions highlighted, and the support settings panel on the right.",
    caption:
      'Support Studio with island scanning on. The highlight is where the model has nothing under it, and the panel is where the tree is shaped.',
  },
  {
    src: '/media/multi-plate.webp',
    alt: 'Four plates laid out in one scene in Prepare mode, each labelled, with a model on the first.',
    caption: 'Multi-plate. Four plates in one scene, with the model list switching between them.',
  },
  {
    src: '/media/3daa.webp',
    alt: 'Printing mode: the printed model with the current layer highlighted, beside a layer preview whose mask has soft grey edges rather than a hard black-and-white one.',
    caption:
      '3D anti-aliasing. The layer mask carries grey levels rather than a hard edge, which is what smooths a curve and takes the stair-stepping out of a slope.',
  },
];
---

<section class="showcase" aria-label="Screenshots">
  <div class="shell">
    <ul class="grid grid--2 showcase__grid">
      {
        shots.map((shot, index) => (
          <li>
            <button class="shot" type="button" data-zoom data-caption={shot.caption}>
              <img
                src={shot.src}
                alt={shot.alt}
                width="1600"
                height="870"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="shot__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10.5" cy="10.5" r="6.5"></circle>
                  <path d="m15.5 15.5 4.5 4.5"></path>
                </svg>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Enlarged screenshot">
  <div class="lightbox__panel">
    <img data-lightbox-image alt="" width="1600" height="870" />
    <div class="lightbox__bar">
      <p class="lightbox__caption mono muted" data-lightbox-caption></p>
      <button class="lightbox__button" type="button" data-lightbox-prev aria-label="Previous screenshot">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5.5 8.5 12l6.5 6.5"></path>
        </svg>
      </button>
      <button class="lightbox__button" type="button" data-lightbox-next aria-label="Next screenshot">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5.5 15.5 12 9 18.5"></path>
        </svg>
      </button>
    </div>
  </div>
  <button class="lightbox__button lightbox__close" type="button" data-lightbox-close aria-label="Close the enlarged screenshot">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m7 7 10 10"></path>
      <path d="M17 7 7 17"></path>
    </svg>
  </button>
</dialog>

<script>
  // The grid is static, so the only script is the lightbox: it copies a tile
  // into the dialog before opening it, and the dialog itself handles Escape,
  // the focus trap and returning focus to a tile. The arrows step through the
  // same four images, wrapping at either end, so the next picture never costs
  // a close and a click.
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');
  const close = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const prev = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const next = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-zoom]')];

  if (lightbox && image && caption && close && prev && next && tiles.length > 0) {
    // The tile whose image is on screen. Closing sends focus back to it rather
    // than to the one that happened to be pressed.
    let current = 0;

    const show = (index: number) => {
      current = (index + tiles.length) % tiles.length;

      const tile = tiles[current];
      const thumbnail = tile.querySelector('img');
      if (!thumbnail) return;

      image.src = thumbnail.currentSrc || thumbnail.src;
      image.alt = thumbnail.alt;
      caption.textContent = tile.dataset.caption ?? '';
    };

    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => {
        show(index);
        if (!lightbox.open) lightbox.showModal();
      });
    });

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    lightbox.addEventListener('close', () => tiles[current]?.focus());

    close.addEventListener('click', () => lightbox.close());

    // The panel covers the dialog, so a click that reaches the dialog element
    // itself is a click on the backdrop.
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  }
</script>

<style>
  .showcase {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem);
  }

  .showcase__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Two tracks, so the four images are two rows of two at every width a
       desktop reaches; the shared .grid--2 turns that into one column on a
       phone, where two screenshots side by side are too small to read. */
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  /* The whole image, not a corner of it: the tile is the target. The caption
     stays on the button as data - the grid shows the pictures and nothing
     else, and the text appears with the enlarged one. */
  .shot {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: 0.4rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-shadow);
    cursor: zoom-in;
  }

  .shot img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: calc(var(--radius-lg) - 5px);
  }

  .shot:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .shot__badge {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    color: var(--ink);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    /* Always there rather than revealed on hover: a touch screen has no hover
       to reveal it with, and a screenshot that does not look like a button is
       one nobody presses. */
    opacity: 0.8;
    transition: opacity 0.16s var(--ease);
  }

  .shot:hover .shot__badge,
  .shot:focus-visible .shot__badge {
    opacity: 1;
  }

  .lightbox {
    /* The UA centres a modal with `margin: auto` inside a fixed inset: 0 box,
       and the global `* { margin: 0 }` reset takes that away - so the dialog
       lands in the top-left corner unless it is stated back here. */
    margin: auto;
    max-inline-size: 96vw;
    max-block-size: 94vh;
    padding: 0;
    color: var(--ink);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(11 15 20 / 0.78);
  }

  .lightbox__panel {
    display: flex;
    flex-direction: column;
  }

  /* Never past the file's own pixels: these are 1600 px wide, and blowing a
     screenshot up beyond its width is the one thing a zoom view must not do.
     Width is left auto so a viewport shorter than the image shrinks both sides
     and keeps the aspect ratio. The 4.5rem is the bar the caption and the
     arrows share. */
  .lightbox__panel img {
    display: block;
    inline-size: auto;
    max-inline-size: min(96vw, 1600px);
    block-size: auto;
    max-block-size: calc(94vh - 4.5rem);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
  }

  .lightbox__caption {
    flex: 1 1 auto;
    margin: 0;
    font-size: 0.75rem;
  }

  .lightbox__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    color: var(--ink);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.16s var(--ease);
  }

  .lightbox__button:hover {
    background: var(--bg-inset);
  }

  .lightbox__button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Over the top-right corner of the image: the bar's own two arrows are in
     the bar, and a lone control up there is the one place a lightbox always
     puts a close. */
  .lightbox__close {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
  }
</style>
