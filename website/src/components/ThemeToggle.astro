---
const { class: className = '' } = Astro.props;
---

<button
  class={`theme-toggle ${className}`}
  type="button"
  data-theme-toggle
  aria-label="Switch colour theme"
  title="Switch colour theme"
>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.1M12 19.3v2.1M4.2 12H2.1M21.9 12h-2.1M6.5 6.5 5 5M19 19l-1.5-1.5M17.5 6.5 19 5M5 19l1.5-1.5"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path>
  </svg>
  <span class="visually-hidden">Toggle theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.125rem;
    block-size: 2.125rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease), background-color 0.16s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-toggle > svg:first-of-type {
    display: none;
  }
</style>
