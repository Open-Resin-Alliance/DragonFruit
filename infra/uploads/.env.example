# Copy to .env next to compose.yml and fill in. .env is gitignored.

# Public HTTPS address the tunnel/proxy serves, without a trailing slash.
UPLOADS_EXTERNAL_URL=https://uploads.example.com
# Where the uploaded files live on the host, e.g. a NAS mount. Must exist and
# be writable by UID 1000.
UPLOADS_FILES_DIR=/mnt/nas/dragonfruit-issues
# Generate both with: openssl rand -base64 32
UPLOADS_ADMIN_PASSWORD=
UPLOADS_TOTP_SECRET=
