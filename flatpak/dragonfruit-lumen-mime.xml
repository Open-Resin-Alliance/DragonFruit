<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.openresin.lumen">
    <comment>DragonFruit LUMEN Print</comment>
    <icon name="org.openresinalliance.dragonfruit"/>
    <glob pattern="*.lumen"/>
    <alias type="application/x-lumen"/>
    <magic priority="50">
      <match type="string" offset="0" value="LUMN"/>
    </magic>
  </mime-type>
</mime-info>
