# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# package management
/.pnp
/node_modules
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# framework/build outputs
/.next/
/build
/coverage
/dist/
/out/
/.venv
**/target/
# per-variant build dirs from scripts/bench/run-slicing-bench.sh --codegen
**/target-codegen-*/
src-tauri/frontend-dist/**
src-tauri/gen/

# generated artifacts
**/generated*

# The site: landing page and documentation, one Astro build
# (see docs/dev/site-and-landing.md).
/website/dist/
/website/node_modules/
/website/.astro/
/docs/assets/placeholders/*png

# environment files (can opt-in for committing if needed)
.env*
!.env.example

# logs/debug
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# local/project-specific
/.claude/
/.windsurf/
/.vscode/
/*.code-workspace
/run.bat
/fixtures/
/spec/
/supports_legacy
conversion/
Scratch/
.scratch/
todo_list
tsc_output.txt

# backups
2_Backup/

# platform/deployment
.vercel

src-tauri/gen/
src-tauri/frontend-dist/**
conversion/

**/target/

# misc
*.pem
.DS_Store

# Tauri updater signing private key (keep secret!)
.tauri/app.key

# Generated build artifacts that cause rebuild loops
src-tauri/generated_crate_requirements.toml
src-tauri/nsis/
src-tauri/binding.rs
src-tauri/permissions.toml

# compiled native binaries / COM DLLs (built locally, not committed)
src-tauri/windows-resources/*.dll
src-tauri/windows-resources/nsis-plugins/
src-tauri/windows-resources/runtime-version.nsh
src-tauri/windows-resources/runtime-version.wxi
src-tauri/binaries/dragonfruit-voxl-thumbnailer*
**/build
# Editor swap files (vim leaves these next to the file being edited)
*.swp
*.swo
*~

# Local-only refactor scaffolding (golden masters + harness). Never commit.
/local-only/

# Directory-scoped agent notes: local working aids, not project docs.
src/**/AGENTS.md
