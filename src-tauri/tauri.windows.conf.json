{
  "build": {
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-runtime.ps1"
  },
  "bundle": {
    "targets": ["nsis"],
    "licenseFile": "nsis/assets/license.txt",
    "resources": {
      "windows-resources/dragonfruit_voxl_thumbnail_com.dll": "dragonfruit_voxl_thumbnail_com.dll",
      "windows-resources/nsis-plugins/InetC.txt": "licenses/InetC.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/thumbnail-hooks.nsh",
        "headerImage": "nsis/assets/header.bmp",
        "sidebarImage": "nsis/assets/sidebar.bmp"
      }
    }
  }
}
